# Public origin the QR codes point to (no trailing slash). Must be reachable from guests' phones.
PUBLIC_BASE_URL=https://booth.example.com

# Event slug stored with each strip.
EVENT_SLUG=halloween-2026

# Secret used to sign 10-minute image URLs (local driver) — any long random string.
SIGNING_SECRET=change-me-to-a-long-random-string

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/cron/cleanup.
CRON_SECRET=change-me-too

# "local" stores files in ./.data (dev, or a single always-on server).
# "s3" uses any S3-compatible bucket (Amazon S3, Cloudflare R2). Required on Vercel.
STORAGE_DRIVER=local

S3_BUCKET=
S3_REGION=auto
# For Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
